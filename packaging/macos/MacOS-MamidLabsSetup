#!/bin/zsh
# Inner launcher of MamidLabs Setup.app.
#
# Runs the wizard with the Python sources embedded inside the application bundle.
# It uses the system Python (or Homebrew Python 3.12); when PySide6 is missing the
# wizard prints a clear message and exits.
set -e

BUNDLE_DIR="$(cd "$(dirname "$0")/.." && pwd)"
SRC_DIR="$BUNDLE_DIR/Resources/mamidlabs-src"

PYTHON=""
for candidate in /opt/homebrew/bin/python3.12 /usr/local/bin/python3.12 \
                 /opt/homebrew/bin/python3 /usr/local/bin/python3 /usr/bin/python3; do
  if [ -x "$candidate" ]; then
    PYTHON="$candidate"
    break
  fi
done
if [ -z "$PYTHON" ]; then
  PYTHON="$(command -v python3 || true)"
fi
if [ -z "$PYTHON" ]; then
  osascript -e 'display alert "MamidLabs" message "Python 3 not found. Install: brew install python@3.12" as critical' >/dev/null 2>&1 || true
  exit 1
fi

export PYTHONPATH="$SRC_DIR${PYTHONPATH:+:$PYTHONPATH}"
exec "$PYTHON" -m mamidlabs.wizard "$@"
