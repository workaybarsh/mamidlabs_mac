# macOS deposu: satır sonları her zaman LF olsun (CRLF karışıklığı olmasın).
* text=auto eol=lf

*.sh   text eol=lf
*.py   text eol=lf
*.svg  text eol=lf
*.plist text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.ini  text eol=lf
*.toml text eol=lf

# İkili dosyalar
*.gguf   binary
*.mmproj binary
*.png    binary
*.jpg    binary
*.ico    binary
*.icns   binary
