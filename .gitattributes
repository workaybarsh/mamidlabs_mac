# macOS repository: line endings are always LF (no CRLF mix-ups).
* text=auto eol=lf

*.sh   text eol=lf
*.py   text eol=lf
*.svg  text eol=lf
*.plist text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.ini  text eol=lf
*.toml text eol=lf

# Binary files
*.gguf   binary
*.mmproj binary
*.png    binary
*.jpg    binary
*.ico    binary
*.icns   binary
